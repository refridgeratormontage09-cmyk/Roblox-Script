    -- CARD BUILDERS
    -- ========================
    local function MakeCard(parent, order, h)
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, h or 46)
        card.BackgroundColor3 = C.CARD
        card.BorderSizePixel = 0
        card.LayoutOrder = order or 0
        card.ZIndex = 7
        card.Parent = parent
        Corner(card, 8)
        Stroke(card, C.BORDER, 1)
        return card
    end

    local function MakeSectionLabel(parent, text, order)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 18)
        lbl.BackgroundTransparency = 1
        lbl.Text = "  ▸ " .. text
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextColor3 = C.ACCENT
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.LayoutOrder = order or 0
        lbl.ZIndex = 7
        lbl.Parent = parent
        return lbl
    end

    local function MakeToggle(parent, label, order, callback)
        local card = MakeCard(parent, order)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.62, 0, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.Font = Enum.Font.GothamSemibold
        lbl.TextSize = 13
        lbl.TextColor3 = C.TEXT
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 8
        lbl.Parent = card

        local toggle = Instance.new("TextButton")
        toggle.Size = UDim2.new(0, 54, 0, 26)
        toggle.Position = UDim2.new(1, -64, 0.5, -13)
        toggle.BackgroundColor3 = C.BORDER
        toggle.Text = "OFF"
        toggle.Font = Enum.Font.GothamBold
        toggle.TextSize = 11
        toggle.TextColor3 = C.MUTED
        toggle.BorderSizePixel = 0
        toggle.ZIndex = 9
        toggle.Parent = card
        Corner(toggle, 6)

        local state = false
        toggle.MouseButton1Click:Connect(function()
            state = not state
            if state then
                Tween(toggle, {BackgroundColor3 = C.ACCENT}, 0.15)
                toggle.TextColor3 = C.TEXT
                toggle.Text = "ON"
            else
                Tween(toggle, {BackgroundColor3 = C.BORDER}, 0.15)
                toggle.TextColor3 = C.MUTED
                toggle.Text = "OFF"
            end
            callback(state)
        end)
        return card, toggle
    end

