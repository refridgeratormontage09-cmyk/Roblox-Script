    MakeSectionLabel(univPage, "MOVEMENT", 1)

    MakeInputRow(univPage, "WalkSpeed", "16", 2, function(val)
        local n = tonumber(val)
        if n then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = n
            end
        end
    end)

    MakeInputRow(univPage, "JumpPower", "50", 3, function(val)
        local n = tonumber(val)
        if n then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.JumpPower = n
            end
        end
    end)

    MakeSectionLabel(univPage, "FLY", 4)

    MakeToggle(univPage, "Fly", 5, function(state)
        flyEnabled = state
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if state then
            -- Delta-safe: LinearVelocity + AlignOrientation (BodyVelocity/BodyGyro are deprecated)
            local att = Instance.new("Attachment")
            att.Name = "FlyAttachment"
            att.Parent = hrp
            local lv = Instance.new("LinearVelocity")
            lv.Attachment0 = att
            lv.VectorVelocity = Vector3.zero
            lv.MaxForce = 1e5
            lv.Parent = hrp
            flyBV = lv
            local ao = Instance.new("AlignOrientation")
            ao.Attachment0 = att
            ao.RigidityEnabled = false
            ao.MaxTorque = 1e5
            ao.MaxAngularVelocity = math.huge
            ao.CFrame = hrp.CFrame
            ao.Parent = hrp
            flyBG = ao
        else
            if flyBV then flyBV:Destroy(); flyBV = nil end
            if flyBG then flyBG:Destroy(); flyBG = nil end
            local att = hrp:FindFirstChild("FlyAttachment")
            if att then att:Destroy() end
        end
    end)

    MakeInputRow(univPage, "Fly Speed", "60", 6, function(val)
        local n = tonumber(val)
        if n then flySpeed = n end
    end)

    Track(RunService.Heartbeat:Connect(function()
        if flyEnabled and flyBV and flyBG then
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            flyBV.VectorVelocity = Camera.CFrame.LookVector * flySpeed
            flyBG.CFrame = Camera.CFrame
        end
    end))

    MakeSectionLabel(univPage, "ESP", 7)

    local function AddESP(char, name)
        if espHighlights[name] then
            pcall(function() espHighlights[name]:Destroy() end)
        end
        local hl = Instance.new("Highlight")
        hl.FillColor = C.ACCENT
        hl.OutlineColor = Color3.fromRGB(170, 215, 255)
        hl.FillTransparency = 0.55
        hl.Parent = char
        espHighlights[name] = hl
    end

    local function ClearESP()
        for _, hl in pairs(espHighlights) do
            pcall(function() hl:Destroy() end)
        end
        espHighlights = {}
    end

    MakeToggle(univPage, "ESP (Player Highlight)", 8, function(state)
        espEnabled = state
        ClearESP()
        if state then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    AddESP(plr.Character, plr.Name)
                end
            end
        end
    end)

    Track(Players.PlayerAdded:Connect(function(plr)
        Track(plr.CharacterAdded:Connect(function(char)
            if espEnabled then AddESP(char, plr.Name) end
        end))
    end))
    Track(Players.PlayerRemoving:Connect(function(plr)
        if espHighlights[plr.Name] then
            pcall(function() espHighlights[plr.Name]:Destroy() end)
            espHighlights[plr.Name] = nil
        end
    end))
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            Track(plr.CharacterAdded:Connect(function(char)
                if espEnabled then AddESP(char, plr.Name) end
            end))
        end
    end

    MakeSectionLabel(univPage, "MISC", 9)

    local afkConn = nil
    MakeToggle(univPage, "Anti-AFK", 10, function(state)
        if state then
            afkConn = Track(LocalPlayer.Idled:Connect(function()
                -- Delta-safe: fire jump state instead of VirtualInputManager
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("Humanoid") then
                        char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end)
            end))
        else
            if afkConn then afkConn:Disconnect(); afkConn = nil end
        end
    end)

    local ijConn = nil
    MakeToggle(univPage, "Infinite Jump", 11, function(state)
        if state then
            ijConn = Track(UserInputService.JumpRequest:Connect(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end))
        else
            if ijConn then ijConn:Disconnect(); ijConn = nil end
        end
    end)

