        descL.TextXAlignment = Enum.TextXAlignment.Left
        descL.TextWrapped = true
        descL.ZIndex = 8
        descL.Parent = card

        local execBtn = Instance.new("TextButton")
        execBtn.Size = UDim2.new(0, 62, 0, 30)
        execBtn.Position = UDim2.new(1, -72, 0.5, -15)
        execBtn.BackgroundColor3 = C.ACCENT
        execBtn.Text = "Execute"
        execBtn.Font = Enum.Font.GothamBold
        execBtn.TextSize = 11
        execBtn.TextColor3 = C.TEXT
        execBtn.BorderSizePixel = 0
        execBtn.ZIndex = 9
        execBtn.Parent = card
        Corner(execBtn, 6)

        local isRunning = false
        execBtn.MouseButton1Click:Connect(function()
            if entry.name == "FE Noclip" then
                noclipEnabled = not noclipEnabled
                if noclipEnabled then
                    execBtn.Text = "Stop"
                    Tween(execBtn, {BackgroundColor3 = C.RED}, 0.15)
                else
                    execBtn.Text = "Execute"
                    Tween(execBtn, {BackgroundColor3 = C.ACCENT}, 0.15)
                    local char = LocalPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = true
                            end
                        end
                    end
                end
            else
                if not isRunning then
                    isRunning = true
                    execBtn.Text = "Running"
                    Tween(execBtn, {BackgroundColor3 = C.GREEN}, 0.15)
                    task.wait(1.5)
                    execBtn.Text = "Execute"
                    Tween(execBtn, {BackgroundColor3 = C.ACCENT}, 0.15)
                    isRunning = false
                end
            end
        end)

        table.insert(feCards, {frame = card, name = entry.name})
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
