local function BuildMLogo(parent, size, zIdx)
    size = size or 30
    zIdx = zIdx or 8
    local logo = Instance.new("TextLabel")
    logo.Size = UDim2.new(0, 48, 0, 42)
    logo.BackgroundTransparency = 1
    logo.Text = "M"
    logo.Font = Enum.Font.GothamBlack
    logo.TextSize = size
    logo.TextColor3 = C.ACCENT
    logo.TextXAlignment = Enum.TextXAlignment.Center
    logo.ZIndex = zIdx
    logo.Parent = parent

    local glow = Instance.new("UIStroke")
    glow.Color = C.ACCENT
    glow.Thickness = 1.5
    glow.Parent = logo

    task.spawn(function()
        while logo.Parent do
            Tween(glow, {Thickness = 2.8}, 1.0)
            task.wait(1.0)
            Tween(glow, {Thickness = 0.7}, 1.0)
            task.wait(1.0)
        end
    end)

    return logo
end

